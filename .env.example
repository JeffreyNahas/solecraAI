# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=solecra
POSTGRES_PASSWORD=
POSTGRES_DB=solecra
# Used when running the app outside Docker (compose sets its own):
DATABASE_URL=postgresql://solecra:CHANGE_ME@localhost:5432/solecra

# --- WhatsApp Cloud API (Meta developer app) ---
# Any random string you choose; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# WhatsApp > API setup (temporary token for dev; system user token for prod)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# true = log outgoing messages instead of sending them
WHATSAPP_DRY_RUN=false

# --- Owners allowed to talk to the bot: phone:name, comma separated, country code included ---
OWNER_PHONES=15145550001:Owner1,15145550002:Owner2

# --- Dev only: save raw webhook bodies to build test fixtures ---
# WEBHOOK_CAPTURE_DIR=./captures

# --- LLMs (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL_SCORING=anthropic/claude-haiku-4.5
LLM_MODEL_RESEARCH=anthropic/claude-haiku-4.5
LLM_MODEL_DRAFTING=anthropic/claude-sonnet-5.5
LLM_FALLBACK_MODELS=

# --- Permits ingestion and scoring ---
PERMITS_LOOKBACK_DAYS=30
PERMITS_MAX_KM=30
PERMITS_MIN_UNITS=4
LEAD_SCORE_THRESHOLD=60
SCORING_MAX_PER_RUN=100

# --- Lead research (finds the company and a published contact) ---
RESEARCH_MAX_PER_DAY=15
RESEARCH_MAX_TURNS=8
RESEARCH_MAX_SEARCHES=4
RESEARCH_MAX_USD_PER_DAY=1.5

# --- Outreach emails ---
OUTREACH_DAILY_CAP=15
OUTREACH_DRAFT_EXPIRY_BUSINESS_DAYS=2
OUTREACH_CONSENT_MAX_AGE_DAYS=30
# Owners' approved numbers (comma-separated) and supplier/brand names never to mention
OUTREACH_ALLOWED_NUMBERS=
OUTREACH_BLOCKED_TERMS=

# --- Company identity in every outreach email (CASL) ---
COMPANY_NAME=Solecra
COMPANY_SENDER_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
# Public https URL of the bot (unsubscribe links), e.g. https://bot.<domain>
PUBLIC_BASE_URL=
# test = only these addresses can receive outreach email (real leads are held)
EMAIL_MODE=test
EMAIL_TEST_RECIPIENTS=
# Sending window (Montréal time) and random gap between emails, in minutes
EMAIL_SEND_START_HOUR=9
EMAIL_SEND_END_HOUR=16
EMAIL_GAP_MIN_MINUTES=15
EMAIL_GAP_MAX_MINUTES=35
# Test mode only: send as soon as the job runs, any hour, no gap (to try the whole path)
EMAIL_TEST_IGNORES_SCHEDULE=false
# Gmail credentials go in a SEPARATE file, .env.gmail (git-ignored; only the scheduler reads it):
#   GMAIL_CLIENT_ID=  GMAIL_CLIENT_SECRET=  GMAIL_REFRESH_TOKEN=  GMAIL_SENDER=
# Create it with: uv run python -m scripts.gmail_auth

# --- Run tracking: GitHub issues for repeated job failures (empty token = off) ---
# Fine-grained token: this repo only, permission Issues: Read and write.
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=JeffreyNahas/solecraAI
RUN_FAILURE_ISSUE_THRESHOLD=3
TIMEZONE=America/Montreal

# --- Server only (Caddy HTTPS) ---
BOT_DOMAIN=bot.example.com

LOG_LEVEL=INFO
