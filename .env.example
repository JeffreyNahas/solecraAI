# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=solecra
POSTGRES_PASSWORD=
POSTGRES_DB=solecra
# Used when running the app outside Docker (compose sets its own):
DATABASE_URL=postgresql://solecra:CHANGE_ME@localhost:5432/solecra

# --- WhatsApp Cloud API (Meta developer app) ---
# Any random string you choose; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# WhatsApp > API setup (temporary token for dev; system user token for prod)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# true = log outgoing messages instead of sending them
WHATSAPP_DRY_RUN=false

# --- Owners allowed to talk to the bot: phone:name, comma separated, country code included ---
OWNER_PHONES=15145550001:Owner1,15145550002:Owner2

# --- Dev only: save raw webhook bodies to build test fixtures ---
# WEBHOOK_CAPTURE_DIR=./captures

# --- Later phases ---
OPENROUTER_API_KEY=

# --- Server only (Caddy HTTPS) ---
BOT_DOMAIN=bot.example.com

LOG_LEVEL=INFO
